# Gemini API Key (Autonomous Document Intelligence & OCR Enhancement)
GEMINI_API_KEY=

# ==============================================================================
# OPTIONAL: Remote AI Background Removal Provider
# ==============================================================================
# The application starts and runs normally without these variables.
# By default, OMNISCAN TITAN X uses its high-performance, offline Local Biometric AI
# engine and browser-based chroma/canvas matting tools with zero network latency.
#
# If you wish to connect an external AI model service (e.g. BiRefNet, RMBG, InSPyReNet)
# later, you can uncomment and configure these server-side environment variables:
#
# BG_REMOVAL_ENDPOINT=https://your-custom-ai-service.com/api/background/remove
# BG_REMOVAL_API_KEY=your_optional_service_api_key
# BG_REMOVAL_AUTH_HEADER=Bearer
# BG_REMOVAL_TIMEOUT_MS=45000
